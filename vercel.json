{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/media/(.*)",
      "dest": "/media/$1"
    },
    {
      "src": "/(.*\\.(?:webp|png|jpg|jpeg|svg|ico|mp4|css|js|woff|woff2|ttf|eot))",
      "dest": "/$1"
    },
    {
      "src": "/process-contact",
      "dest": "/api/process-contact.php"
    },
    {
      "src": "/process-contact.php",
      "dest": "/api/process-contact.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
